# DeepSeek is the sole production model provider. A configured key does not trigger calls.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Developer quick validation only. Uses the CLI's configured model service, not local inference.
# Set the executable that passed validation; batch runs record its resolved path and SHA-256.
CODEX_EXECUTABLE=codex
CODEX_MODEL=
