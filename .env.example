# DeepSeek is the sole production model provider. A configured key does not trigger calls.
# Web admin settings override this fallback key; new accounts receive configurable initial credit (10 CNY by default).
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Developer quick validation only. Uses the CLI's configured model service, not local inference.
# Set the executable that passed validation; batch runs record its resolved path and SHA-256.
CODEX_EXECUTABLE=codex
CODEX_MODEL=

# Web application. SQLite is an explicit local development option; Compose uses PostgreSQL.
TEASSISTANT_DATABASE_URL=sqlite:///work/web/teassistant.db
TEASSISTANT_DATA_DIR=
TEASSISTANT_BANK_DIR=
TEASSISTANT_SEMANTIC_DIR=
TEASSISTANT_CURRICULUM=
TEASSISTANT_FRONTEND_DIST=
TEASSISTANT_SECURE_COOKIES=0
TEASSISTANT_MODEL_PROVIDER=deepseek
# Only enable on a developer machine when Codex CLI validation is explicitly selected.
TEASSISTANT_ALLOW_CODEX=0
TEASSISTANT_SOFFICE=
TEASSISTANT_XELATEX=
TEASSISTANT_REDIS_URL=redis://localhost:6379/0

# Docker deployment uses a separate .env.deploy, generated from .env.deploy.example.
# Run: python3 scripts/deploy.py init
