# scripts/deploy.py init generates a private database password from this template.
# Compose deployment configuration is separate from the developer .env.
COMPOSE_PROJECT_NAME=teassistant
TEASSISTANT_IMAGE=teassistant:local
TEASSISTANT_BIND=127.0.0.1
TEASSISTANT_PORT=8000
TEASSISTANT_DB_PASSWORD=

# Sole business provider. Key may stay blank until saved in the admin UI.
# Web metering currently permits deepseek-flash at the official endpoint only.
DEEPSEEK_API_KEY=
DEEPSEEK_MODEL=deepseek-flash
DEEPSEEK_BASE_URL=https://api.deepseek.com

# Enable after connecting through an HTTPS reverse proxy.
TEASSISTANT_SECURE_COOKIES=0

# Read-only host folder. init creates it. Sources never enter the image.
# Copy the complete package (source/, semantic/, evidence/, manifest.json) here.
# Then enable both container paths below. Account seeds use a separate private file.
TEASSISTANT_HOST_BANK_ROOT=./runtime/bank
TEASSISTANT_BANK_DIR=
TEASSISTANT_SEMANTIC_DIR=
TEASSISTANT_CURRICULUM=/app/data/curricula/junior-math-2022-draft-v2.json
