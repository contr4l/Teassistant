{
  "$defs": {
    "ExamEvidence": {
      "additionalProperties": false,
      "properties": {
        "page_id": {
          "title": "Page Id",
          "type": "string"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "kind": {
          "enum": [
            "printed_question",
            "handwriting",
            "grading",
            "reference",
            "header"
          ],
          "title": "Kind",
          "type": "string"
        },
        "excerpt": {
          "default": "",
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "page_id",
        "bbox",
        "kind"
      ],
      "title": "ExamEvidence",
      "type": "object"
    }
  },
  "additionalProperties": false,
  "properties": {
    "id": {
      "title": "Id",
      "type": "string"
    },
    "base_revision": {
      "title": "Base Revision",
      "type": "string"
    },
    "number": {
      "maximum": 300,
      "minimum": 1,
      "title": "Number",
      "type": "integer"
    },
    "part_path": {
      "default": "",
      "title": "Part Path",
      "type": "string"
    },
    "outcome": {
      "anyOf": [
        {
          "enum": [
            "correct",
            "incorrect",
            "partial",
            "unanswered",
            "unknown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Outcome"
    },
    "response_ids": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Ids"
    },
    "response_id": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Response Id"
    },
    "corrected_transcript": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corrected Transcript"
    },
    "corrected_response_number": {
      "anyOf": [
        {
          "maximum": 300,
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corrected Response Number"
    },
    "corrected_part_path": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Corrected Part Path"
    },
    "point_ids": {
      "anyOf": [
        {
          "items": {
            "type": "string"
          },
          "type": "array"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Point Ids"
    },
    "reason": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason"
    },
    "reason_status": {
      "anyOf": [
        {
          "enum": [
            "supported",
            "hypothesis",
            "unknown"
          ],
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Reason Status"
    },
    "evidence": {
      "items": {
        "$ref": "#/$defs/ExamEvidence"
      },
      "minItems": 1,
      "title": "Evidence",
      "type": "array"
    }
  },
  "required": [
    "id",
    "base_revision",
    "number",
    "evidence"
  ],
  "title": "ExamCorrection",
  "type": "object"
}
