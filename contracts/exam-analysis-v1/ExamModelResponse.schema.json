          "type": "array"
        },
        "unresolved": {
          "items": {
            "type": "string"
          },
          "maxItems": 30,
          "title": "Unresolved",
          "type": "array"
        }
      },
      "required": [
        "overview"
      ],
      "title": "TeacherReport",
      "type": "object"
