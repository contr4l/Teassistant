    "GradingObservation": {
      "additionalProperties": false,
      "properties": {
        "part_path": {
          "default": "",
          "title": "Part Path",
          "type": "string"
        },
        "kind": {
          "enum": [
            "mark",
            "deducted",
            "awarded",
            "maximum",
            "total_awarded",
            "total_maximum"
          ],
          "title": "Kind",
          "type": "string"
        },
        "value": {
          "anyOf": [
            {
              "maximum": 10000,
              "minimum": 0,
              "type": "number"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Value"
        },
        "mark": {
          "anyOf": [
            {
              "enum": [
                "correct",
                "incorrect",
                "partial",
                "unclear"
              ],
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Mark"
        },
        "literal": {
          "minLength": 1,
          "title": "Literal",
          "type": "string"
        },
        "sources": {
          "items": {
            "$ref": "#/$defs/ExamEvidence"
          },
          "minItems": 1,
          "title": "Sources",
          "type": "array"
        }
      },
      "required": [
        "kind",
        "literal",
        "sources"
      ],
      "title": "GradingObservation",
      "type": "object"
    },
