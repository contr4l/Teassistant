          "title": "Kind",
          "type": "string"
        },
        "excerpt": {
          "default": "",
          "title": "Excerpt",
          "type": "string"
        }
      },
      "required": [
        "page_id",
        "bbox",
        "kind"
      ],
      "title": "ExamEvidence",
      "type": "object"
    },
    "ExamRegion": {
      "additionalProperties": false,
      "properties": {
        "page_id": {
          "title": "Page Id",
          "type": "string"
        },
        "bbox": {
          "maxItems": 4,
          "minItems": 4,
          "prefixItems": [
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            },
            {
              "maximum": 1,
              "minimum": 0,
              "type": "number"
            }
          ],
          "title": "Bbox",
          "type": "array"
        },
        "role": {
          "enum": [
            "paper",
            "response",
            "reference"
          ],
          "title": "Role",
          "type": "string"
        },
        "question_numbers": {
          "items": {
            "maximum": 300,
            "minimum": 1,
            "type": "integer"
