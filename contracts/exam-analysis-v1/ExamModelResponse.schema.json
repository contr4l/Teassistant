  "additionalProperties": false,
  "description": "One stage per request; the orchestrator rejects fields from other stages.",
  "properties": {
    "task": {
      "enum": [
        "layout",
        "paper",
        "reference",
        "response",
        "diagnosis",
        "report"
      ],
      "title": "Task",
      "type": "string"
    },
    "exam_title": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Exam Title"
    },
    "page_classification": {
      "default": "unclear",
      "enum": [
        "paper",
        "response",
        "reference",
        "mixed",
        "blank",
        "unclear"
      ],
      "title": "Page Classification",
      "type": "string"
    },
    "printed_page_number": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Printed Page Number"
    },
    "printed_page_count": {
      "anyOf": [
        {
          "minimum": 1,
          "type": "integer"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "title": "Printed Page Count"
    },
    "regions": {
      "items": {
        "$ref": "#/$defs/ExamRegion"
      },
      "title": "Regions",
      "type": "array"
    },
    "questions": {
      "items": {
        "$ref": "#/$defs/PaperQuestion"
      },
      "title": "Questions",
      "type": "array"
    },
    "scoring_rules": {
      "items": {
        "$ref": "#/$defs/SectionScoreRule"
      },
      "title": "Scoring Rules",
      "type": "array"
    },
    "responses": {
      "items": {
        "$ref": "#/$defs/StudentResponse"
      },
      "title": "Responses",
      "type": "array"
    },
    "grading": {
      "items": {
        "$ref": "#/$defs/GradingObservation"
      },
      "title": "Grading",
      "type": "array"
    },
    "diagnoses": {
      "items": {
        "$ref": "#/$defs/DiagnosisProposal"
      },
      "title": "Diagnoses",
      "type": "array"
    },
    "teacher_report": {
      "anyOf": [
        {
          "$ref": "#/$defs/TeacherReport"
        },
        {
          "type": "null"
        }
      ],
      "default": null
    },
    "reference_answers": {
      "items": {
        "$ref": "#/$defs/ReferenceAnswer"
      },
      "title": "Reference Answers",
      "type": "array"
    },
    "warnings": {
      "items": {
        "type": "string"
      },
      "title": "Warnings",
      "type": "array"
    }
  },
  "required": [
    "task"
  ],
  "title": "ExamModelResponse",
  "type": "object"
}
