{
  "$defs": {
    "DiagnosisProposal": {
      "additionalProperties": false,
      "properties": {
        "number": {
          "maximum": 300,
          "minimum": 1,
          "title": "Number",
          "type": "integer"
        },
        "part_path": {
          "default": "",
          "title": "Part Path",
          "type": "string"
        },
        "outcome": {
          "enum": [
            "correct",
            "incorrect",
            "partial",
            "unanswered",
            "unknown"
          ],
          "title": "Outcome",
          "type": "string"
        },
        "point_ids": {
          "items": {
            "type": "string"
          },
          "title": "Point Ids",
          "type": "array"
        },
        "reason": {
          "default": "",
          "title": "Reason",
          "type": "string"
        },
        "reason_status": {
          "default": "unknown",
          "enum": [
            "supported",
            "hypothesis",
            "unknown"
          ],
          "title": "Reason Status",
          "type": "string"
        },
        "evidence": {
          "items": {
            "$ref": "#/$defs/ExamEvidence"
          },
          "title": "Evidence",
          "type": "array"
        },
        "suggested_action": {
          "default": "",
          "title": "Suggested Action",
          "type": "string"
        }
      },
      "required": [
        "number",
        "outcome"
      ],
      "title": "DiagnosisProposal",
      "type": "object"
    },
    "ExamEvidence": {
      "additionalProperties": false,
      "properties": {
        "page_id": {
          "title": "Page Id",
          "type": "string"
