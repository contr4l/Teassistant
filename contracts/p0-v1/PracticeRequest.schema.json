                  "intermediate",
                  "advanced"
                ]
              },
              "type": "object"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "By Difficulty"
        },
        "reference_score": {
          "default": 50,
          "maximum": 100,
          "minimum": 0,
          "title": "Reference Score",
          "type": "integer"
